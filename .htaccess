# fuell-process.com – Apache configuration for the static site.
# If the host runs nginx/openresty instead of Apache, see README.md for the equivalent rules.

DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical origin: https://fuell-process.com (no http, no www)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://fuell-process.com%{REQUEST_URI} [L,R=301]

  # Old WordPress URLs
  RewriteRule ^en/main-home/?$ /en/ [L,R=301]
  RewriteRule ^(portfolio-item|portfolio-category|carousels-category)(/.*)?$ / [L,R=301]
  RewriteRule ^en/(portfolio-item|portfolio-category|carousels-category)(/.*)?$ /en/ [L,R=301]
  RewriteRule ^(en/)?feed/?$ / [L,R=301]
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php)(/.*)?$ - [G]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|png|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/xml image/svg+xml
</IfModule>

AddType text/plain .txt
AddDefaultCharset utf-8
